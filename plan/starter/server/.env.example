# Copy this file to server/.env and edit. Every line is optional in development.

# Leave empty to use the built-in private MongoDB (data in server/.data). Set to an Atlas URI to use a real cluster.
MONGODB_URI=

# Required in production. Any long random string.
JWT_SECRET=

# Port of the API. The website dev server reads this line too, so change it only here.
# If the API says the port is reserved or in use, pick another number (for example 5050) and restart both dev servers.
PORT=5000
